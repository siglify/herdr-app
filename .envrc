# Let rustup apply this workspace's rust-toolchain.toml.
PATH_add "${CARGO_HOME:-$HOME/.cargo}/bin"

# Homebrew keeps versioned Zig installations outside its default PATH.
if has brew; then
    siglify_zig_prefix="$(brew --prefix zig@0.16 2>/dev/null)"
    if [[ -x "$siglify_zig_prefix/bin/zig" ]]; then
        PATH_add "$siglify_zig_prefix/bin"
    fi
fi

ZIG="$(command -v zig)" || { log_error "Install Zig 0.16.0 before loading this environment."; return 1; }
export ZIG
if [[ "$("$ZIG" version)" != "0.16.0" ]]; then
    log_error "This repo requires Zig 0.16.0 (on Homebrew: brew install zig@0.16)."
    return 1
fi
